# Optional: Set GEMINI_API_KEY to enable live cloud Gemini Argon API calls.
# If omitted or empty, the backend automatically uses the built-in local deterministic
# Gemini Argon + RDKit 8-Gate SMIRKS reasoning engine (works 100% offline with zero keys).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
